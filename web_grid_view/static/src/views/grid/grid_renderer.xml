<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_grid_view.GridRenderer">
        <div class="o_grid_renderer" t-ref="grid">
            <t t-if="!model.activeRange">
                <div class="text-muted p-4 text-center">
                    <i class="fa fa-th fa-2x mb-2" />
                    <p>This view does not support date columns.</p>
                </div>
            </t>
            <t t-elif="!hasData">
                <div class="text-muted p-4 text-center">
                    <i class="fa fa-inbox fa-2x mb-2" />
                    <p>No data for this period.</p>
                </div>
            </t>
            <t t-else="">
                <div class="o_grid_table_wrap">
                    <div
                        class="o_grid_table_inner"
                        t-att-style="'grid-template-columns: ' + gridTemplateColumns"
                    >
                        <!-- Header row -->
                        <div class="o_grid_header_cell o_grid_corner" />
                        <t t-foreach="visibleColumns" t-as="col" t-key="col.id">
                            <div
                                t-att-class="'o_grid_header_cell o_grid_col_header' + (col.isToday ? ' o_grid_today' : '') + (col.isWeekend ? ' o_grid_weekend' : '')"
                                t-att-data-col-id="col.id"
                            >
                                <span t-esc="col.label" />
                            </div>
                        </t>
                        <div class="o_grid_header_cell o_grid_total_header">Total</div>

                        <!-- Sections with rows -->
                        <t t-if="model.hasSections">
                            <t
                                t-foreach="model.sections"
                                t-as="section"
                                t-key="section.id"
                            >
                                <!-- Section header -->
                                <div
                                    class="o_grid_section_label"
                                    t-att-data-row-id="section.id"
                                >
                                    <strong t-esc="section.label" />
                                </div>
                                <div
                                    t-foreach="visibleColumns"
                                    t-as="col"
                                    t-key="col.id"
                                    class="o_grid_section_cell"
                                />
                                <div class="o_grid_section_total">
                                    <strong t-esc="formatValue(section.grandTotal)" />
                                </div>

                                <!-- Rows in section -->
                                <t t-foreach="section.rows" t-as="row" t-key="row.id">
                                    <div
                                        class="o_grid_row_label"
                                        t-att-data-row-id="row.id"
                                        t-att-class="state.hoveredRow === row.id ? 'o_grid_hovered' : ''"
                                    >
                                        <span t-esc="row.label" />
                                    </div>
                                    <t
                                        t-foreach="visibleColumns"
                                        t-as="col"
                                        t-key="col.id"
                                    >
                                        <div
                                            t-att-class="'o_grid_cell' + (col.isToday ? ' o_grid_today' : '') + (col.isWeekend ? ' o_grid_weekend' : '') + (isHovered(row.id, col.id) ? ' o_grid_hovered' : '')"
                                            t-att-data-row-id="row.id"
                                            t-att-data-col-id="col.id"
                                            t-on-mouseover="onCellMouseOver(row.id, col.id)"
                                            t-on-mouseout="onCellMouseOut()"
                                            t-on-click="onCellClick(row.id, col.id)"
                                        >
                                            <t t-if="isEditing(row.id, col.id)">
                                                <input
                                                    type="text"
                                                    class="o_grid_cell_input form-control form-control-sm"
                                                    t-att-value="getCell(row, col.id)?.value or ''"
                                                    t-on-keydown.prevent="onCellNavigate"
                                                />
                                            </t>
                                            <t t-elif="getCell(row, col.id)">
                                                <span
                                                    t-esc="formatValue(getCell(row, col.id).value)"
                                                />
                                            </t>
                                        </div>
                                    </t>
                                    <div
                                        class="o_grid_row_total"
                                        t-att-class="state.hoveredRow === row.id ? 'o_grid_hovered' : ''"
                                    >
                                        <strong t-esc="formatValue(row.grandTotal)" />
                                    </div>
                                </t>
                            </t>
                        </t>

                        <!-- Rows without sections -->
                        <t t-else="">
                            <t t-foreach="model.rows" t-as="row" t-key="row.id">
                                <div
                                    class="o_grid_row_label"
                                    t-att-data-row-id="row.id"
                                    t-att-class="state.hoveredRow === row.id ? 'o_grid_hovered' : ''"
                                >
                                    <span t-esc="row.label" />
                                </div>
                                <t t-foreach="visibleColumns" t-as="col" t-key="col.id">
                                    <div
                                        t-att-class="'o_grid_cell' + (col.isToday ? ' o_grid_today' : '') + (col.isWeekend ? ' o_grid_weekend' : '') + (isHovered(row.id, col.id) ? ' o_grid_hovered' : '')"
                                        t-att-data-row-id="row.id"
                                        t-att-data-col-id="col.id"
                                        t-on-mouseover="onCellMouseOver(row.id, col.id)"
                                        t-on-mouseout="onCellMouseOut()"
                                        t-on-click="onCellClick(row.id, col.id)"
                                    >
                                        <t t-if="isEditing(row.id, col.id)">
                                            <input
                                                type="text"
                                                class="o_grid_cell_input form-control form-control-sm"
                                                t-att-value="getCell(row, col.id)?.value or ''"
                                            />
                                        </t>
                                        <t t-elif="getCell(row, col.id)">
                                            <span
                                                t-esc="formatValue(getCell(row, col.id).value)"
                                            />
                                        </t>
                                    </div>
                                </t>
                                <div
                                    class="o_grid_row_total"
                                    t-att-class="state.hoveredRow === row.id ? 'o_grid_hovered' : ''"
                                >
                                    <strong t-esc="formatValue(row.grandTotal)" />
                                </div>
                            </t>
                        </t>

                        <!-- Footer: column totals -->
                        <div class="o_grid_footer_label">
                            <strong>Total</strong>
                        </div>
                        <t t-foreach="visibleColumns" t-as="col" t-key="col.id">
                            <div
                                class="o_grid_footer_cell"
                                t-att-class="state.hoveredCol === col.id ? 'o_grid_hovered' : ''"
                            >
                                <strong t-esc="formatValue(col.grandTotal)" />
                            </div>
                        </t>
                        <div class="o_grid_footer_corner" />

                        <!-- Bar chart row -->
                        <t
                            t-if="model.archInfo &amp;&amp; model.archInfo.hasBarchartTotal"
                        >
                            <div class="o_grid_barchart_label" />
                            <t t-foreach="visibleColumns" t-as="col" t-key="col.id">
                                <div class="o_grid_barchart_cell">
                                    <div
                                        class="o_grid_barchart_bar"
                                        t-att-style="'height: ' + getBarHeight(col)"
                                    />
                                </div>
                            </t>
                            <div class="o_grid_barchart_corner" />
                        </t>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
