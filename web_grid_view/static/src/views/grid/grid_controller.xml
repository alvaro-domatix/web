<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="web_grid_view.GridController">
        <Layout className="'o_grid_controller'">
            <t t-set-slot="control-panel-bottom">
                <div class="o_grid_toolbar d-flex align-items-center gap-2 py-1">
                    <div class="btn-group btn-group-sm">
                        <t t-foreach="ranges" t-as="range" t-key="range.name">
                            <button
                                class="btn btn-outline-secondary"
                                t-att-class="range.name === activeRangeName ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.onRangeSelect(range.name)"
                            >
                                <t t-esc="range.string" />
                            </button>
                        </t>
                    </div>
                    <button
                        class="btn btn-sm btn-outline-secondary"
                        t-on-click="onPrev"
                        title="Previous"
                    >
                        <i class="fa fa-chevron-left" />
                    </button>
                    <span class="o_grid_period_label fw-medium" t-esc="periodLabel" />
                    <button
                        class="btn btn-sm btn-outline-secondary"
                        t-on-click="onNext"
                        title="Next"
                    >
                        <i class="fa fa-chevron-right" />
                    </button>
                    <button
                        class="btn btn-sm btn-outline-primary"
                        t-on-click="onToday"
                    >Today</button>
                </div>
            </t>
            <GridRenderer model="model" onCellCommit="onCellCommit" />
        </Layout>
    </t>
</templates>
